{
  "name": "bunus",
  "version": "0.1.0",
  "private": true,
  "description": "Bunus.app - multi-tenant digital loyalty platform",
  "license": "MIT",
  "overrides": {
    "rxjs": "7.8.1"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @bunus/api",
    "dev:web": "npm run dev -w @bunus/web",
    "build": "npm run build -w @bunus/api && npm run build -w @bunus/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @bunus/api && npm run typecheck -w @bunus/web",
    "test": "npm run test -w @bunus/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed/seed.ts"
  }
}
