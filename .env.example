# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Public origin of the web app. Used for CORS and the Origin check on cookie-authenticated writes.
APP_ORIGIN=http://localhost:5173
# Set to the number of reverse proxies in front of the API (Nginx = 1) so client IPs are correct.
TRUST_PROXY=0

# --- Database (MySQL 8) ---
MYSQL_ROOT_PASSWORD=bunus_root_dev
MYSQL_DATABASE=bunus
MYSQL_USER=bunus
MYSQL_PASSWORD=bunus_dev
DATABASE_URL=mysql://bunus:bunus_dev@localhost:3306/bunus

# --- Sessions ---
SESSION_COOKIE_NAME=bunus_session
SESSION_TTL_DAYS=30

# --- Signup OTP ---
# otpid = real delivery through OTP.ID. fake = local development only (code is always 123456);
# the API refuses to start with fake when NODE_ENV=production.
OTP_PROVIDER=fake
OTP_ID_API_KEY=
OTP_ID_BASE_URL=https://api.otp.id
# Credits at or below this value trigger a low-balance alert.
OTP_ID_LOW_BALANCE_THRESHOLD=50000
# Which verification channels users may pick. Remove one to switch it off.
OTP_ENABLED_CHANNELS=email,whatsapp,sms

OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
OTP_MAX_WRONG_CODES=5
# How long a pending signup stays valid before the user must start again.
SIGNUP_TTL_MINUTES=30
